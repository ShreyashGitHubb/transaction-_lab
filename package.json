{
  "name": "concurrent-ticket-booking",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently \"node server/server.js\" \"npm --prefix client run dev -- --host 0.0.0.0\"",
    "server": "node server/server.js",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "mysql2": "^3.24.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
