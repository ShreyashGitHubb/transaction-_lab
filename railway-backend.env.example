# Railway backend service variables
# Add this to the separate Node backend service, not the MySQL service.
# Railway resolves these references automatically.
MYSQL_URL=${{MySQL.MYSQL_URL}}
PORT=${{PORT}}

# If the MySQL service has a different name, replace MySQL above.
# Example:
# MYSQL_URL=${{mysql.MYSQL_URL}}

# For an external backend such as Render, do not use the private URL above.
# Add the Railway MYSQL_PUBLIC_URL privately in the hosting dashboard instead:
MYSQL_URL=mysql://root:YOUR_RAILWAY_PASSWORD@YOUR_RAILWAY_HOST:YOUR_RAILWAY_PORT/railway
